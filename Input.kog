~ simple program to create a list and fill it with primes from num1 to num2

def bool isPrime(int num)
    if num <= 1
        return False
    end
    for j in range(2, num//2 + 1)
        if num % j == 0
            return False
        end
    end
    return True

def Array primesInRange(int num1, int num2)
    if num1 >= num2
        println("Invalid range", num1, num2)
        exit(1)
    end
    all = Array[(num2-num1)//2]
    count = 0
    for i in range(num1, num2)
        if isPrime(i)
            all[count] = i
            count = count + 1
        end
    end
    all = all[:count]
    return all

list = primesInRange(intput(28), intput(28))
printarrln(list)
